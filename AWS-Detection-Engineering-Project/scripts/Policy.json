aws cloudtrail service control policy


{
  "Version":"2012-10-17",
  "Statement":[
    {
      "Sid":"ProtectCloudTrail",
      "Effect":"Deny",
      "Action":[
        "cloudtrail:StopLogging",
        "cloudtrail:DeleteTrail"
      ],
      "Resource":"*"
    }
  ]
}
